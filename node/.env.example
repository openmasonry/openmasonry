# Canonical repository and this node's witness name (must match the genesis entry).
OM_WITNESS_REMOTE=https://github.com/openmasonry/openmasonry.git
OM_WITNESS_NAME=witness-1
OM_WITNESS_KEY=/keys/witness
OM_WITNESS_INTERVAL=3600
# pr = push a branch and open an auto-merging PR (recommended); direct = push to main; none = verify only
OM_WITNESS_PUSH=pr
# Fine-grained token limited to this repository: Contents RW, Pull requests RW, Issues RW.
GH_TOKEN=
# Where the node remembers the head of main it last verified (default: witness-heads.json beside the clone, in /data).
# OM_WITNESS_HEADS=/data/witness-heads.json
