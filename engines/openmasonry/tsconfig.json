{
  // Editor and type-check configuration: every source and test file, nothing emitted.
  // The build (tsconfig.build.json) narrows it to src/ and writes dist/.
  "include": ["src", "test"],
  "compilerOptions": {
    "noEmit": true,

    "module": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  }
}
